# --- Firebase client config (safe to expose in the browser) ---
# Firebase console -> Project settings -> General -> "Your apps" -> Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Firebase Admin (server-only, never exposed to the browser) ---
# Firebase console -> Project settings -> Service accounts -> Generate new private key
# Paste values from the downloaded JSON file.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Keep the literal \n sequences in the private key when pasting it here.
FIREBASE_PRIVATE_KEY=""

# --- TikTok (Phase 2 auto-sync) ---
# From your TikTok Developer app's main dashboard page.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
